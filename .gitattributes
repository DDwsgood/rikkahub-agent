# Baseline Profile 生成文件：标记为文本，统一使用 LF 换行，避免 CRLF 抖动
app/src/release/generated/baselineProfiles/*.txt text eol=lf

# Patch payloads intentionally contain diff context prefixes that look like whitespace errors.
.github/termux-bootstrap/*.patch text eol=lf -whitespace
.github/termux-bootstrap/*.sh text eol=lf
.github/workflows/*.yml text eol=lf

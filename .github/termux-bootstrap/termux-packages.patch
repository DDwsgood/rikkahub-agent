 termux_step_pre_configure() {
+	# termux-tools reads these legacy variables from the configure process
+	# environment. The build properties define them as shell variables, but
+	# do not export them, so configure otherwise silently falls back to the
+	# official com.termux paths.
+	export TERMUX_APP_PACKAGE TERMUX_BASE_DIR TERMUX_CACHE_DIR
+	export TERMUX_PREFIX TERMUX_ANDROID_HOME
 	autoreconf -vfi
 }
 
